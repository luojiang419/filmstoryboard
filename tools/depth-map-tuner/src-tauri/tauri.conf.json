{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "filmstoryboard 深度图调参器",
  "version": "0.1.0",
  "identifier": "com.filmstoryboard.depthmap.tuner",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "filmstoryboard 深度图参数调整",
        "width": 1480,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
